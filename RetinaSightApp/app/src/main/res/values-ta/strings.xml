    <string name="quality_title">படத்தை மீண்டும் எடுக்க வேண்டும்</string>
    <string name="quality_subtitle">நம்பகமான பரிசோதனைக்கு இந்தப் படம் போதுமான தெளிவாக இல்லை. இதை இப்போது சரிசெய்வது தவறான முடிவைத் தவிர்க்கும்.</string>
    <string name="quality_issue_blur">தொலைபேசியை அசையாமல் பிடித்து, கேமரா குவிந்த பிறகு படம் எடுக்கவும்.</string>
    <string name="quality_issue_low_light">சிறிது வெளிச்சம் சேர்க்கவும், அல்லது கருவிழி விரிவடைய இருண்ட அறைக்குச் செல்லவும்.</string>
    <string name="quality_issue_overexposed">வெளிச்சம் அதிகம். வெளிச்சத்தைக் குறைக்கவும் அல்லது லென்ஸை சற்று தூரமாக நகர்த்தவும்.</string>
