    <!-- Explanation: composed from REAL model outputs, never generated text -->
    <string name="explain_low_confidence">இந்தப் படத்தைப் பற்றி செயலிக்கு அதிக உறுதி இல்லை. நல்ல வெளிச்சத்தில், கண்ணை நடுவில் வைத்து மற்றொரு படம் எடுத்தால் முடிவு மேலும் நம்பகமாக இருக்கும்.</string>
    <string name="explain_refer_soon">அறிகுறிகளுக்காகக் காத்திருக்க வேண்டாம். இந்த நிலையில் கண்கள் சாதாரணமாகத் தெரியலாம், உணரலாம், இருப்பினும் சிகிச்சை தேவைப்படலாம்.</string>
    <string name="explain_no_dr">இரத்தச் சர்க்கரையைக் கட்டுப்பாட்டில் வைத்திருங்கள், கண்கள் நன்றாக இருந்தாலும் அறிவுறுத்தப்பட்டபடி மீண்டும் பரிசோதித்துக் கொள்ளுங்கள்.</string>
    <string name="explain_heatmap_hint">வண்ணமிட்ட பகுதி, செயலி கண்ணின் எந்தப் பகுதியை அதிகம் பார்த்தது என்பதைக் காட்டுகிறது.</string>
    <string name="explain_borderline_referral">இந்தக் கண் கண் மருத்துவர் பார்க்க வேண்டிய எல்லைக்கு அருகில் உள்ளது. செயலி வேண்டுமென்றே முன்கூட்டியே அனுப்புகிறது, எனவே மாற்றங்கள் சிறியதாக இருந்தாலும் பரிசோதித்துக் கொள்ளுங்கள்.</string>

